<Page
    x:Class="FactorClient.Views.ApprovalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FactorClient.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Approvals" Style="{ThemeResource TitleTextBlockStyle}"/>
            <TextBlock TextWrapping="WrapWholeWords" Opacity="0.65">
                <Run Text="Atomic chained approvals: "/><Run Text="approve runs the whole chain; deny executes zero calls; "/><Run Text="edit is single-call only and fails closed otherwise. "/><Run Text="The denial enters the model's context — the agent is told nothing ran."/>
            </TextBlock>
            <controls:JudgmentCard x:Name="Gate"/>
            <TextBlock x:Name="Echo" TextWrapping="WrapWholeWords" Opacity="0.75"/>
        </StackPanel>
    </ScrollViewer>
</Page>
