<Page
    x:Class="FactorClient.Views.ChroniclePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel x:Name="Feed" Spacing="0" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Chronicle" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,4"/>
            <TextBlock Text="Every event the wire carried, in order — the session's memory."
                       Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.65" Margin="0,0,0,16"/>
            <!-- Cards are built in code-behind from the session feed. -->
        </StackPanel>
    </ScrollViewer>
</Page>
