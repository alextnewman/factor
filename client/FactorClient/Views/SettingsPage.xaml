<Page
    x:Class="FactorClient.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}"/>
        <ToggleSwitch Header="Default approval guard" IsOn="True"
                      OnContent="Project → user writes ask first"
                      OffContent="Project → user writes run free"/>
        <TextBlock TextWrapping="WrapWholeWords" Opacity="0.65" FontSize="12.5">
            The guard is semantic state, not a security boundary — either the sandbox holds or it doesn't.
            Terminal lifecycle stays bounded (FA_MAX_TERMINALS) and ungated either way.
        </TextBlock>
        <ToggleSwitch Header="Flair renderer" IsOn="False"
                      OnContent="Dress the chronicle in sigils and chrome"
                      OffContent="Brutally plain, greppable, copyable"/>
    </StackPanel>
</Page>
