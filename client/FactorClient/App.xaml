<Application
    x:Class="FactorClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FactorClient">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The judgment gate's material: acrylic with an accent-leaning tint.
                 Real AcrylicBrush, resolved by the compositor — not a CSS blur. -->
            <AcrylicBrush x:Key="JudgmentAcrylic"
                          TintColor="#182635" TintOpacity="0.82"
                          TintLuminosityOpacity="0.85"
                          FallbackColor="#141E29" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
